{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "launchnests",
  "main": "worker.ts",
  "keep_vars": true,
  "vars": {
    "NEXT_CACHE_DO_QUEUE_REVALIDATION_TIMEOUT_MS": "30000",
  },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Monday 00:00 UTC is when scheduled launches go live; 00:30 retries the rollover in case the first run failed.
  // 03:00 daily runs the badge re-check and must match BADGE_CHECK_CRON in constants/badges.ts.
  "triggers": {
    "crons": ["0 0 * * 1", "30 0 * * 1", "0 3 * * *"],
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "launchnests-inc-cache",
    },
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "launchnests",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler",
      },
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"],
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "10ccf10c7906487a9673acb25a28aced",
    },
  ],
}
